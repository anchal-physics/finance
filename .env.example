# Copy this file to `.env` (gitignored) and fill in the values. The Python
# scripts (build_transactions.py, update_effective_holdings.py) load `.env`
# automatically; real environment variables / GitHub Actions secrets always
# override it. NEVER put real ids/keys in this committed example file.

# The Google Sheet ("Finance") id — from the sheet URL /spreadsheets/d/<ID>/.
FINANCE_SHEET_ID=PUT-SPREADSHEET-ID-HERE

# Drive folder id holding the brokerage transaction CSVs, shared (Viewer) with
# the service account. From the folder URL /drive/folders/<ID>. Optional — omit
# to read local data/*.csv instead.
TX_DRIVE_FOLDER=PUT-DRIVE-FOLDER-ID-HERE

# Service-account key path (default: service_account.json next to the scripts).
# GSPREAD_SA_FILE=service_account.json
